import sys
import psutil
import pyqtgraph as pg

from collections import deque
from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget,
    QVBoxLayout, QLabel
)
from PyQt6.QtCore import QTimer


class EnergyGraphs(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("MysticPulse - Energy Graphs")
        self.resize(900, 700)

        self.history_size = 100

        self.cpu_history = deque([0] * self.history_size, maxlen=self.history_size)
        self.ram_history = deque([0] * self.history_size, maxlen=self.history_size)
        self.disk_history = deque([0] * self.history_size, maxlen=self.history_size)

        central = QWidget()
        layout = QVBoxLayout(central)

        self.cpu_plot = self.create_graph("CPU Usage", "#00e5ff")
        self.ram_plot = self.create_graph("RAM Usage", "#b388ff")
        self.disk_plot = self.create_graph("Disk Usage", "#69f0ae")

        layout.addWidget(self.cpu_plot)
        layout.addWidget(self.ram_plot)
        layout.addWidget(self.disk_plot)

        self.setCentralWidget(central)

        self.cpu_line = self.cpu_plot.plot(
            pen=pg.mkPen("#00e5ff", width=2),
            fillLevel=0,
            brush=(0, 229, 255, 40)
        )

        self.ram_line = self.ram_plot.plot(
            pen=pg.mkPen("#b388ff", width=2),
            fillLevel=0,
            brush=(179, 136, 255, 40)
        )

        self.disk_line = self.disk_plot.plot(
            pen=pg.mkPen("#69f0ae", width=2),
            fillLevel=0,
            brush=(105, 240, 174, 40)
        )

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_graphs)
        self.timer.start(1000)

    def create_graph(self, title, color):
        graph = pg.PlotWidget(title=title)
        graph.setBackground("#101820")
        graph.setYRange(0, 100)
        graph.setLabel("left", "Usage (%)")
        graph.setLabel("bottom", "Time (samples)")
        graph.showGrid(x=True, y=True, alpha=0.25)
        graph.setTitle(title, color=color, size="12pt")
        return graph

    def update_graphs(self):
        cpu = psutil.cpu_percent()
        ram = psutil.virtual_memory().percent

        # Disk space occupied on the system drive.
        disk = psutil.disk_usage("/").percent

        self.cpu_history.append(cpu)
        self.ram_history.append(ram)
        self.disk_history.append(disk)

        x = list(range(self.history_size))

        self.cpu_line.setData(x, list(self.cpu_history))
        self.ram_line.setData(x, list(self.ram_history))
        self.disk_line.setData(x, list(self.disk_history))


if __name__ == "__main__":
    app = QApplication(sys.argv)

    window = EnergyGraphs()
    window.show()

    sys.exit(app.exec())
